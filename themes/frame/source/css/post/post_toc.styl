#floating-toc
  --toc-width 272px
  position fixed
  z-index 9
  top 6px
  bottom 6px
  left 6px
  display flex
  color $color-text-primary
  pointer-events none

.post-toc-panel
  position relative
  width 0
  opacity 0
  overflow hidden
  background $color-background
  border-right $line-third solid $color-text-fourth
  box-shadow 2px 0 12px $color-overlay
  transition width .3s ease, opacity .2s ease

.post-toc-header
  display flex
  align-items center
  justify-content space-between
  padding 14px
  border-bottom $line-third solid $color-text-fourth

.toc-title
  font-weight $font-weight-semibold

.toc-pin
  cursor pointer
  color $color-text-primary
  background transparent
  border 1px solid transparent
  border-radius 3px
  transition background .15s ease, border-color .15s ease, transform .15s ease
  &:hover, &:focus-visible
    background $color-text-fourth
    border-color $color-text-third

.toc-pin
  padding 5px
  font-size 14px

.post-toc-scroll
  height calc(100% - 52px)
  overflow-y auto
  padding 10px

.toc-entries
  ul, ol
    margin-left 8px
  // toc-child 原本使用瀏覽器預設的 padding-inline-start: 40px
  .toc-child
    padding-inline-start 8px
  .toc
    padding-inline-start 8px
  a
    display flex
    align-items center
    padding 6px 10px
    border-left 2px solid transparent
    border-radius 2px
    color $color-text-secondary
    font-size 14px
    line-height 20px
    transition color .15s ease, background .15s ease, border-color .15s ease
    &:hover, &:focus-visible
      color $color-text-primary
      background $color-text-fourth
    &.toc-active
      color $color-text-primary
      font-weight $font-weight-semibold
      background $color-text-fourth
      border-left-color $color-code-highlight
  ul
    margin-left 8px
  ol, ul
    list-style none

.post-toc-rail
  width 40px
  display flex
  flex-direction column
  align-items center
  background $color-background
  border-right $line-third solid $color-text-fourth
  pointer-events auto

.toc-rail-icon
  display block
  margin-top 12px
  color $color-text-primary
  font-size 18px
  line-height 20px

#floating-toc.is-open
  pointer-events auto
  .post-toc-panel
    width var(--toc-width)
    opacity 1

body.has-post-toc .wrapper
  margin-left 48px
  transition margin-left .3s ease

body.has-post-toc.toc-is-pinned .wrapper
  margin-left calc(var(--toc-width, 272px) + 48px)

#floating-toc.is-pinned
  .toc-pin
    background $color-text-fourth
    border-color $color-code-highlight
    box-shadow 0 0 0 2px $color-overlay

@media (max-width: 700px)
  // Frame 在 700px 以下改用自己的窄版 layout；此時完全停用 content，避免兩套寬度邏輯互相影響。
  #floating-toc
    display none
  body.has-post-toc .wrapper, body.has-post-toc.toc-is-open .wrapper, body.has-post-toc.toc-is-pinned .wrapper
    margin-left 0
