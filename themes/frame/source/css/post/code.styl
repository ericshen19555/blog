code
    text-style(code-highlight)
    
.code 
    pre
        span
            text-style(code-default)

.highlight
    margin 0 0 $margin-m-2 0
    // Keep the code surface and its horizontal scrollbar in the same theme color.
    background-color $color-code-background
    scrollbar-color $color-text-secondary $color-code-background

    &::-webkit-scrollbar-track
        background $color-code-background

    &::-webkit-scrollbar-thumb
        border-color $color-code-background

    pre
        scrollbar-color $color-text-secondary $color-code-background

        &::-webkit-scrollbar-track
            background $color-code-background

        &::-webkit-scrollbar-thumb
            border-color $color-code-background

    .line
        width $margin-l-2

td.gutter
    width $margin-m-2
    position -webkit-sticky
    position sticky
    left 0
    span
        text-style(code-marker)
        
    pre
        overflow-x visible

td
    span
        line-height $margin-s-2

pre
    margin 0
    overflow-x auto

