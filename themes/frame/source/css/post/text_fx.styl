// Shared text effect layout and custom cursor.
.fx-text
  font-size 5rem
  font-family 'Arial Black', sans-serif
  color #ffffff
  text-transform uppercase
  position relative
  display inline-block
  transition color 0.4s ease, transform 0.4s ease
  cursor var(--fx-cursor, pointer)

.fx-text::after
  content attr(data-text)
  position absolute
  top 0
  left 0
  z-index -1
  color transparent
  opacity 0
  pointer-events none
  transition opacity 0.4s ease

.fx-text:hover
  transform scale(1.05)

.fx-text:hover::after
  opacity 1

.fx-flame:hover
  color #ffe600

.fx-flame::after
  animation burn 0.5s infinite alternate, heat-wave 1.5s infinite linear

@keyframes burn
  0%
    text-shadow 0 -4px 8px rgba(255, 120, 0, 0.8), -2px -12px 18px rgba(255, 60, 0, 0.7), 2px -20px 35px rgba(255, 0, 0, 0.6), 0 -22px 55px rgba(255, 200, 0, 0.5)
  100%
    text-shadow -1px -6px 12px rgba(255, 150, 0, 0.9), 2px -8px 22px rgba(255, 40, 0, 0.8), -2px -16px 45px rgba(255, 0, 0, 0.5), 1px -28px 65px rgba(255, 230, 0, 0.6)

@keyframes heat-wave
  0%
    transform skewX(0deg)
  25%
    transform skewX(-1deg) skewY(0.5deg)
  50%
    transform skewX(1deg) skewY(-0.5deg)
  75%
    transform skewX(-0.5deg) skewY(0.5deg)
  100%
    transform skewX(0deg)

.fx-holy
  overflow visible

.fx-holy::before
  content ''
  position absolute
  bottom -100px
  left 50%
  transform translateX(-50%) scale(0.85)
  transform-origin bottom center
  width 360px
  height 420px
  background-image url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 360 420'><defs><filter id='feather' x='-30%' y='-30%' width='160%' height='160%'><feGaussianBlur stdDeviation='12'/></filter><radialGradient id='light' cx='50%' cy='35%' r='50%'><stop offset='0%' stop-color='%23ffffff' stop-opacity='1'/><stop offset='25%' stop-color='%23ffeb8c' stop-opacity='0.85'/><stop offset='55%' stop-color='%23ffb41e' stop-opacity='0.4'/><stop offset='85%' stop-color='%23ff9600' stop-opacity='0'/></radialGradient></defs><polygon points='180,30 205,125 330,145 205,165 180,390 155,165 30,145 155,125' fill='url(%23light)' filter='url(%23feather)'/></svg>")
  background-repeat no-repeat
  background-position center bottom
  background-size contain
  mix-blend-mode screen
  opacity 0
  pointer-events none
  z-index -2
  transition opacity 0.4s ease, transform 0.4s ease

.fx-holy::after
  text-shadow 0 4px 8px rgba(255, 255, 255, 0.9), 0 14px 24px rgba(255, 215, 0, 0.8), 0 30px 45px rgba(255, 180, 0, 0.6), 0 55px 75px rgba(255, 255, 255, 0.4)

.fx-holy:hover
  color #fffdf0

.fx-holy:hover::before
  opacity 1
  transform translateX(-50%) scale(1)
